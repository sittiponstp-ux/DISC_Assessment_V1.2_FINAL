const SPREADSHEET_ID="PUT_YOUR_GOOGLE_SHEET_ID_HERE";const SHEET_NAME="DISC_Results";
function doPost(e){try{const d=JSON.parse(e.postData.contents),ss=SpreadsheetApp.openById(SPREADSHEET_ID);let sh=ss.getSheetByName(SHEET_NAME);const h=["Assessment ID","Employee ID","Name","ฝ่าย","แผนก","Timestamp",...Array.from({length:24},(_,i)=>"Q"+String(i+1).padStart(2,"0")),"D Score","I Score","S Score","C Score","Primary Animal","Primary","Secondary Animal","Secondary","Personality Type","Assessment Version"];if(!sh)sh=ss.insertSheet(SHEET_NAME);if(sh.getLastRow()===0)sh.appendRow(h);sh.appendRow([d.assessmentId,d.employeeId,d.name,d.division,d.department,d.timestamp,...d.answers.map(x=>x.style),d.D,d.I,d.S,d.C,d.primaryAnimal,d.primary,d.secondaryAnimal,d.secondary,d.personalityType,d.assessmentVersion]);return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON)}catch(err){return ContentService.createTextOutput(JSON.stringify({ok:false,error:String(err)})).setMimeType(ContentService.MimeType.JSON)}}
function doGet(){return ContentService.createTextOutput(JSON.stringify({status:"DISC API ready"})).setMimeType(ContentService.MimeType.JSON)}
